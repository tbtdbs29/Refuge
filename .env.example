# Copy to .env and adjust
PORT=3000
NODE_ENV=development
# Long random string used to sign session cookies (required in production)
SESSION_SECRET=change-me-with-a-long-random-string
# Public base URL, used in emails and calendar exports
BASE_URL=http://localhost:3000
# Reverse proxies in front of the app (1 behind Nginx/Caddy/PaaS, 0 if exposed directly)
TRUST_PROXY=1
# Local storage (development, or a classic server)
DATABASE_PATH=./data/refuge.sqlite
UPLOAD_DIR=./data/uploads
# Production on Vercel: Turso database and Vercel Blob photo storage
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Optional SMTP settings to receive contact form notifications by email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
