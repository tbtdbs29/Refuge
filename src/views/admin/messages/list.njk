{% extends "layouts/admin.njk" %}
{% from "partials/macros.njk" import icon %}
{% set pageTitle = 'Messages' %}

{% block header %}
<header class="admin-head">
  <div><h1 class="display">Messages</h1><p class="admin-head__sub">Demandes reçues par le formulaire de contact du site.</p></div>
</header>
{% endblock %}

{% block content %}
<div class="toolbar">
  <div class="segmented" role="group" aria-label="Filtrer les messages">
    {% for key, text in labels.MESSAGE_STATUS %}
      <a href="/admin/messages?statut={{ key }}" {% if status == key %}aria-current="page"{% endif %}>{{ text }}{{ 's' if key != 'nouveau' else 'x' }} <span class="count">{{ counts[key] }}</span></a>
    {% endfor %}
  </div>
</div>
{% if messages | length %}
  <ul class="inbox">
    {% for message in messages %}
      <li>
        <a class="inbox__row{% if message.status == 'nouveau' %} is-new{% endif %}" href="/admin/messages/{{ message.id }}">
          <span class="tag tag--{{ message.topic }}">{{ message.topicLabel }}</span>
          <span class="inbox__main">
            <strong>{{ message.name }}{% if message.animal_name %} <span class="inbox__animal">· {{ message.animal_name }}</span>{% endif %}</strong>
            <small>{{ message.body | truncate(140, true, '…') }}</small>
          </span>
          <span class="inbox__date">{{ message.dateLabel }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <div class="admin-empty"><h2 class="display">Boîte vide</h2><p>{{ 'Aucun nouveau message. Tout est traité !' if status == 'nouveau' else 'Aucun message dans cette catégorie.' }}</p></div>
{% endif %}
{% endblock %}
