{#
  Authored illustrations shown on a portrait plate while an animal has no photo yet.
  Colors come from CSS custom properties set on the svg (--fur, --fur-light, --fur-dark, --inner, --iris).
#}
{% macro figure(kind, palette, label, traits={}) %}
<svg class="fig fig--{{ kind }}" viewBox="0 0 200 240" role="img" aria-label="{{ label }}" style="--fur: {{ palette.fur }}; --fur-light: {{ palette.light }}; --fur-dark: {{ palette.dark }}; --iris: {{ palette.iris }};">
  <ellipse class="fig-shadow" cx="100" cy="236" rx="60" ry="5.5"/>
  {% if kind == 'cat' %}
  <path class="fig-tail" d="M136 224 C170 222 180 192 170 168 C164 155 150 156 153 170" fill="none" stroke="var(--fur)" stroke-width="13" stroke-linecap="round"/>
  <path d="M58 234 C52 196 66 156 100 146 C134 156 148 196 142 234 Z" fill="var(--fur)"/>
  <path d="M84 234 C82 204 90 176 100 170 C110 176 118 204 116 234 Z" fill="var(--fur-light)"/>
  {% if traits.pattern == 'tabby' %}<path d="M62 196 q8 -2 14 4 M60 212 q9 -2 15 4 M138 196 q-8 -2 -14 4 M140 212 q-9 -2 -15 4 M66 180 q7 -3 12 2 M134 180 q-7 -3 -12 2" stroke="var(--fur-dark)" stroke-width="4" stroke-linecap="round" fill="none"/>{% endif %}
  <rect x="76" y="198" width="18" height="38" rx="9" fill="var(--fur)"/>
  <rect x="106" y="198" width="18" height="38" rx="9" fill="var(--fur)"/>
  <ellipse cx="85" cy="232" rx="11" ry="5.5" fill="var(--fur-light)"/>
  <ellipse cx="115" cy="232" rx="11" ry="5.5" fill="var(--fur-light)"/>
  <g class="fig-head">
    <g class="fig-ear-l"><path d="M60 98 L62 50 C63 45 68 45 71 48 L96 76 Z" fill="var(--fur)"/><path d="M67 87 L68 60 L86 78 Z" fill="var(--inner)"/></g>
    <g class="fig-ear-r"><path d="M140 98 L138 50 C137 45 132 45 129 48 L104 76 Z" fill="var(--fur)"/><path d="M133 87 L132 60 L114 78 Z" fill="var(--inner)"/></g>
    <ellipse cx="100" cy="108" rx="46" ry="40" fill="var(--fur)"/>
    {% if traits.pattern != 'mask' %}<path d="M92 72 q2 8 0 14 M100 70 q0 9 0 16 M108 72 q-2 8 0 14" stroke="var(--fur-dark)" stroke-width="3" stroke-linecap="round" fill="none"/>{% endif %}
    {% if traits.pattern == 'mask' %}<path d="M100 84 C92 98 74 112 70 128 C78 142 122 142 130 128 C126 112 108 98 100 84 Z" fill="var(--fur-light)"/>{% endif %}
    <ellipse cx="100" cy="126" rx="21" ry="13" fill="var(--fur-light)"/>
    {% if traits.senior %}<ellipse cx="100" cy="128" rx="18" ry="10" fill="var(--grey)"/>{% endif %}
    <circle cx="70" cy="122" r="7" fill="var(--blush)"/>
    <circle cx="130" cy="122" r="7" fill="var(--blush)"/>
    <g class="fig-eyes">
      <ellipse cx="83" cy="106" rx="7" ry="8" fill="var(--iris)"/>
      <ellipse cx="83" cy="106" rx="3.4" ry="7" fill="#17151c"/>
      <circle cx="85" cy="103" r="1.9" fill="#fff"/>
      <ellipse cx="117" cy="106" rx="7" ry="8" fill="var(--iris)"/>
      <ellipse cx="117" cy="106" rx="3.4" ry="7" fill="#17151c"/>
      <circle cx="119" cy="103" r="1.9" fill="#fff"/>
    </g>
    <path d="M95 117 h10 l-5 6 z" fill="var(--inner)" stroke="var(--inner)" stroke-width="2" stroke-linejoin="round"/>
    <path d="M100 123 v3 M100 126 c-3 4 -8 4 -10 1 M100 126 c3 4 8 4 10 1" stroke="#17151c" stroke-width="1.8" fill="none" stroke-linecap="round"/>
    <path d="M78 123 l-24 -4 M78 128 l-23 3 M122 123 l24 -4 M122 128 l23 3" stroke="var(--whisker)" stroke-width="1.3" stroke-linecap="round"/>
  </g>
  {% elif kind == 'dog' %}
  <path class="fig-tail" d="M134 216 C160 208 170 188 164 170" fill="none" stroke="var(--fur)" stroke-width="12" stroke-linecap="round"/>
  <path d="M54 234 C48 192 66 152 100 144 C134 152 152 192 146 234 Z" fill="var(--fur)"/>
  <path d="M82 234 C80 200 90 170 100 164 C110 170 120 200 118 234 Z" fill="var(--fur-light)"/>
  <rect x="73" y="194" width="21" height="42" rx="10" fill="var(--fur)"/>
  <rect x="106" y="194" width="21" height="42" rx="10" fill="var(--fur)"/>
  <ellipse cx="83" cy="232" rx="12" ry="5.5" fill="var(--fur-light)"/>
  <ellipse cx="117" cy="232" rx="12" ry="5.5" fill="var(--fur-light)"/>
  <path d="M70 142 C88 154 112 154 130 142" stroke="var(--collar)" stroke-width="8" fill="none" stroke-linecap="round"/>
  <circle class="fig-tag" cx="100" cy="155" r="6" fill="#E9B43C" stroke="#B9871A" stroke-width="1.5"/>
  <g class="fig-head">
    {% if traits.ears == 'pointy' %}
    <g class="fig-ear-l"><path d="M64 92 L60 40 C61 35 66 34 69 37 L92 70 Z" fill="var(--fur)"/><path d="M68 82 L66 50 L84 72 Z" fill="var(--inner)"/></g>
    <g class="fig-ear-r"><path d="M136 92 L140 40 C139 35 134 34 131 37 L108 70 Z" fill="var(--fur)"/><path d="M132 82 L134 50 L116 72 Z" fill="var(--inner)"/></g>
    {% elif traits.ears == 'long' %}
    <path class="fig-ear-l" d="M66 76 C40 80 30 130 38 172 C42 184 58 184 62 172 C68 146 72 110 78 84 Z" fill="var(--fur-dark)"/>
    <path class="fig-ear-r" d="M134 76 C160 80 170 130 162 172 C158 184 142 184 138 172 C132 146 128 110 122 84 Z" fill="var(--fur-dark)"/>
    {% else %}
    <path class="fig-ear-l" d="M64 78 C44 82 36 116 46 138 C52 147 63 143 67 132 C71 118 73 100 76 86 Z" fill="var(--fur-dark)"/>
    <path class="fig-ear-r" d="M136 78 C156 82 164 116 154 138 C148 147 137 143 133 132 C129 118 127 100 124 86 Z" fill="var(--fur-dark)"/>
    {% endif %}
    <ellipse cx="100" cy="102" rx="42" ry="40" fill="var(--fur)"/>
    <path d="M100 64 C93 80 91 96 93 110 L107 110 C109 96 107 80 100 64 Z" fill="var(--fur-light)"/>
    <ellipse cx="100" cy="125" rx="24" ry="18" fill="var(--fur-light)"/>
    <circle cx="69" cy="118" r="7" fill="var(--blush)"/>
    <circle cx="131" cy="118" r="7" fill="var(--blush)"/>
    {% if traits.pattern == 'patch' %}<ellipse cx="82" cy="96" rx="15" ry="13" fill="var(--fur-dark)" transform="rotate(-15 82 96)"/>{% endif %}
    {% if traits.senior %}<ellipse cx="100" cy="128" rx="20" ry="13" fill="var(--grey)"/><path d="M72 86 q10 -7 20 -1 M108 85 q10 -6 20 1" stroke="var(--grey)" stroke-width="5" stroke-linecap="round" fill="none"/>{% endif %}
    <g class="fig-eyes">
      <circle cx="82" cy="98" r="6.5" fill="#17151c" stroke="var(--fur-light)" stroke-width="1.5"/>
      <circle cx="84" cy="95.5" r="2" fill="#fff"/>
      <circle cx="118" cy="98" r="6.5" fill="#17151c" stroke="var(--fur-light)" stroke-width="1.5"/>
      <circle cx="120" cy="95.5" r="2" fill="#fff"/>
    </g>
    <ellipse cx="100" cy="114" rx="9.5" ry="6.5" fill="#17151c"/>
    <ellipse cx="97" cy="112" rx="3" ry="1.6" fill="#fff" opacity=".55"/>
    <path class="fig-tongue" d="M94.5 129 C94.5 141 105.5 141 105.5 129 Z" fill="#E8798A"/>
    <path d="M100 120 v7 M100 127 c-4 5 -10 5 -13 1 M100 127 c4 5 10 5 13 1" stroke="#17151c" stroke-width="1.8" fill="none" stroke-linecap="round"/>
  </g>
  {% elif kind == 'rabbit' %}
  <circle cx="146" cy="216" r="12" fill="var(--fur-light)"/>
  <ellipse cx="100" cy="198" rx="48" ry="40" fill="var(--fur)"/>
  <ellipse cx="100" cy="208" rx="26" ry="26" fill="var(--fur-light)"/>
  <ellipse cx="76" cy="231" rx="21" ry="7" fill="var(--fur)"/>
  <ellipse cx="124" cy="231" rx="21" ry="7" fill="var(--fur)"/>
  <ellipse cx="88" cy="214" rx="7.5" ry="11" fill="var(--fur)"/>
  <ellipse cx="112" cy="214" rx="7.5" ry="11" fill="var(--fur)"/>
  <g class="fig-head">
    {% if traits.ears == 'lop' %}
    <g class="fig-ear-l"><ellipse cx="62" cy="136" rx="13" ry="34" fill="var(--fur-dark)" transform="rotate(14 62 136)"/></g>
    <g class="fig-ear-r"><ellipse cx="138" cy="136" rx="13" ry="34" fill="var(--fur-dark)" transform="rotate(-14 138 136)"/></g>
    {% else %}
    <g class="fig-ear-l"><ellipse cx="82" cy="72" rx="13" ry="40" fill="var(--fur)" transform="rotate(-8 82 72)"/><ellipse cx="82" cy="74" rx="6" ry="29" fill="var(--inner)" transform="rotate(-8 82 74)"/></g>
    <g class="fig-ear-r"><ellipse cx="122" cy="76" rx="13" ry="40" fill="var(--fur)" transform="rotate(16 122 108)"/><ellipse cx="122" cy="78" rx="6" ry="29" fill="var(--inner)" transform="rotate(16 122 108)"/></g>
    {% endif %}
    <ellipse cx="100" cy="128" rx="38" ry="34" fill="var(--fur)"/>
    <ellipse cx="100" cy="141" rx="16" ry="11" fill="var(--fur-light)"/>
    <circle cx="74" cy="138" r="6" fill="var(--blush)"/>
    <circle cx="126" cy="138" r="6" fill="var(--blush)"/>
    <g class="fig-eyes">
      <circle cx="85" cy="124" r="6" fill="#17151c" stroke="var(--fur-light)" stroke-width="1.5"/>
      <circle cx="87" cy="121.5" r="1.9" fill="#fff"/>
      <circle cx="115" cy="124" r="6" fill="#17151c" stroke="var(--fur-light)" stroke-width="1.5"/>
      <circle cx="117" cy="121.5" r="1.9" fill="#fff"/>
    </g>
    <path d="M96 134 h8 l-4 4 z" fill="var(--inner)" stroke="var(--inner)" stroke-width="2" stroke-linejoin="round"/>
    <path d="M100 138 v3 M100 141 c-3 3 -6 3 -8 1 M100 141 c3 3 6 3 8 1" stroke="#17151c" stroke-width="1.6" fill="none" stroke-linecap="round"/>
    <rect x="97" y="143" width="6" height="6" rx="1.5" fill="#fff" stroke="#17151c" stroke-width="1"/>
    <path d="M82 140 l-20 -3 M82 144 l-19 3 M118 140 l20 -3 M118 144 l19 3" stroke="var(--whisker)" stroke-width="1.2" stroke-linecap="round"/>
  </g>
  {% elif kind == 'sheep' %}
  <rect x="80" y="214" width="11" height="22" rx="4" fill="var(--fur-dark)"/>
  <rect x="109" y="214" width="11" height="22" rx="4" fill="var(--fur-dark)"/>
  <g fill="var(--fur)">
    <circle cx="68" cy="186" r="28"/><circle cx="100" cy="176" r="32"/><circle cx="132" cy="186" r="28"/>
    <circle cx="78" cy="208" r="24"/><circle cx="122" cy="208" r="24"/><circle cx="100" cy="204" r="28"/>
  </g>
  <g class="fig-head">
    <g class="fig-ear-l"><ellipse cx="70" cy="122" rx="17" ry="7" fill="var(--fur-dark)" transform="rotate(20 70 122)"/></g>
    <g class="fig-ear-r"><ellipse cx="130" cy="122" rx="17" ry="7" fill="var(--fur-dark)" transform="rotate(-20 130 122)"/></g>
    <ellipse cx="100" cy="134" rx="25" ry="31" fill="var(--fur-dark)"/>
    <g fill="var(--fur)"><circle cx="88" cy="104" r="11"/><circle cx="100" cy="99" r="12"/><circle cx="112" cy="104" r="11"/></g>
    <g class="fig-eyes">
      <circle cx="90" cy="128" r="5.5" fill="#fff"/><circle cx="90.5" cy="128.5" r="3.5" fill="#17151c"/>
      <circle cx="110" cy="128" r="5.5" fill="#fff"/><circle cx="110.5" cy="128.5" r="3.5" fill="#17151c"/>
    </g>
    <ellipse cx="100" cy="150" rx="7" ry="4.5" fill="var(--inner)"/>
    <path d="M100 154 v3 M100 157 c-3 3 -6 3 -8 1 M100 157 c3 3 6 3 8 1" stroke="var(--fur-light)" stroke-width="1.6" fill="none" stroke-linecap="round"/>
  </g>
  {% else %}
  <path d="M56 234 C52 196 66 160 100 152 C134 160 148 196 144 234 Z" fill="var(--fur)"/>
  <path d="M86 234 C84 206 92 184 100 180 C108 184 116 206 114 234 Z" fill="var(--fur-light)"/>
  <rect x="79" y="196" width="15" height="40" rx="6" fill="var(--fur)"/>
  <rect x="106" y="196" width="15" height="40" rx="6" fill="var(--fur)"/>
  <rect x="79" y="228" width="15" height="8" rx="2" fill="var(--fur-dark)"/>
  <rect x="106" y="228" width="15" height="8" rx="2" fill="var(--fur-dark)"/>
  <g class="fig-head">
    <path d="M86 72 C80 50 68 42 57 46" stroke="#CDBB9C" stroke-width="9" fill="none" stroke-linecap="round"/>
    <path d="M114 72 C120 50 132 42 143 46" stroke="#CDBB9C" stroke-width="9" fill="none" stroke-linecap="round"/>
    <g class="fig-ear-l"><ellipse cx="58" cy="94" rx="23" ry="9" fill="var(--fur-dark)" transform="rotate(18 58 94)"/></g>
    <g class="fig-ear-r"><ellipse cx="142" cy="94" rx="23" ry="9" fill="var(--fur-dark)" transform="rotate(-18 142 94)"/></g>
    <path d="M100 64 C126 64 133 86 129 110 C125 134 114 150 100 150 C86 150 75 134 71 110 C67 86 74 64 100 64 Z" fill="var(--fur)"/>
    <path class="fig-beard" d="M92 146 C93 164 100 174 100 174 C100 174 107 164 108 146 Z" fill="var(--fur-dark)"/>
    <ellipse cx="100" cy="134" rx="17" ry="15" fill="var(--fur-light)"/>
    <circle cx="76" cy="118" r="6" fill="var(--blush)"/>
    <circle cx="124" cy="118" r="6" fill="var(--blush)"/>
    <g class="fig-eyes">
      <ellipse cx="85" cy="102" rx="6.5" ry="5.5" fill="#17151c" stroke="var(--fur-light)" stroke-width="1.5"/>
      <circle cx="87" cy="100" r="1.8" fill="#fff"/>
      <ellipse cx="115" cy="102" rx="6.5" ry="5.5" fill="#17151c" stroke="var(--fur-light)" stroke-width="1.5"/>
      <circle cx="117" cy="100" r="1.8" fill="#fff"/>
    </g>
    <ellipse cx="94" cy="134" rx="2.5" ry="1.8" fill="#17151c"/>
    <ellipse cx="106" cy="134" rx="2.5" ry="1.8" fill="#17151c"/>
    <path d="M100 138 v3 M100 141 c-3 3 -7 3 -9 0 M100 141 c3 3 7 3 9 0" stroke="#17151c" stroke-width="1.6" fill="none" stroke-linecap="round"/>
  </g>
  {% endif %}
</svg>
{% endmacro %}
